{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CamMeasure",
  "version": "1.1.0",
  "identifier": "io.github.536338958.cammeasure",
  "build": {
    "beforeDevCommand": "node copy-ui.js",
    "beforeBuildCommand": "node copy-ui.js",
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "CamMeasure Pro",
        "width": 1360,
        "height": 860,
        "minWidth": 920,
        "minHeight": 620,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app", "appimage", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "10.15"
    }
  }
}
